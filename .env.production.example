# Salin menjadi .env.production dan ganti seluruh nilai contoh.
# Jangan commit .env.production dan jangan kirim isinya melalui chat.

APP_NAME="KONI Klaten"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-resmi.example
APP_DOMAIN=domain-resmi.example
ACME_EMAIL=admin@domain-resmi.example
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=koni_klaten
DB_USERNAME=koni_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_UNIK
DB_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_UNIK

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_REDIS_UNIK
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@domain-resmi.example"
MAIL_FROM_NAME="${APP_NAME}"

# Opsional: isi hanya setelah adapter Flysystem S3 dipasang dan bucket privat siap.
KONI_BACKUP_RETENTION_DAYS=30
KONI_BACKUP_SCHEDULE_TIME=02:00
KONI_BACKUP_PROCESS_TIMEOUT=1800
KONI_BACKUP_REMOTE_PREFIX=koni-klaten/backups
KONI_BACKUP_MAX_AGE_HOURS=36
KONI_SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=3
# KONI_BACKUP_REMOTE_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

APP_IMAGE_TAG=2026-11-20
